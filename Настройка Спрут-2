import flet as ft
import re
import datetime

def main(page: ft.Page):
    page.title = "EXML Дата Менеджер"
    page.scroll = "adaptive"
    page.theme_mode = ft.ThemeMode.LIGHT
    
    # Переменные для хранения данных
    file_content = ""
    file_name = ""
    picked_file_path = None
    
    # Списки выбранных элементов
    selected_text_dates = set()
    selected_unix_timestamps = set()

    # Компоненты интерфейса
    status_label = ft.Text("Шаг 1: Выберите файл .exml", size=14, color=ft.colors.GREY_700)
    
    # Контейнеры для списков дат
    text_dates_container = ft.Column(spacing=5)
    unix_timestamps_container = ft.Column(spacing=5)
    
    # Поле ввода для новой текстовой даты
    new_date_input = ft.TextField(label="Новая дата (ДД.ММ.ГГГГ)", width=250, text_size=14)

    # --- ЛОГИКА ОБРАБОТКИ ФАЙЛА ---
    def reset_app():
        nonlocal file_content, selected_text_dates, selected_unix_timestamps
        file_content = ""
        selected_text_dates.clear()
        selected_unix_timestamps.clear()
        text_dates_container.controls.clear()
        unix_timestamps_container.controls.clear()

    def on_file_picked(e: ft.FilePickerResultEvent):
        nonlocal file_content, file_name, picked_file_path
        if not e.files:
            status_label.value = "Файл не выбран"
            page.update()
            return
            
        reset_app()
        picked_file = e.files[0]
        file_name = picked_file.name
        picked_file_path = picked_file.path
        status_label.value = f"Выбран файл: {file_name}"
        
        try:
            with open(picked_file_path, "r", encoding="utf-8") as f:
                file_content = f.read()
            
            # 1. Поиск текстовых дат (ДД.ММ.ГГГГ)
            found_text = sorted(list(set(re.findall(r'\d{2}\.\d{2}\.\d{4}', file_content))))
            if found_text:
                new_date_input.value = found_text[0] # ставим первую как шаблон
                for dt in found_text:
                    def make_on_change_txt(date_val):
                        return lambda e_ch: selected_text_dates.add(date_val) if e_ch.control.value else selected_text_dates.discard(date_val)
                    
                    text_dates_container.controls.append(
                        ft.Checkbox(label=f"Дата: {dt}", on_change=make_on_change_txt(dt))
                    )
            else:
                text_dates_container.controls.append(ft.Text("Даты ДД.ММ.ГГГГ не найдены", italic=True))

            # 2. Поиск Unix-меток
            found_unix = sorted(list(set(re.findall(r'\b\d{10}\b', file_content))))
            if found_unix:
                for ts in found_unix:
                    try:
                        readable = datetime.datetime.fromtimestamp(int(ts)).strftime('%d.%m.%Y %H:%M')
                    except Exception:
                        readable = "Неизвестно"
                        
                    def make_on_change_ux(ts_val):
                        return lambda e_ch: selected_unix_timestamps.add(ts_val) if e_ch.control.value else selected_unix_timestamps.discard(ts_val)
                    
                    unix_timestamps_container.controls.append(
                        ft.Checkbox(label=f"{ts} ({readable})", on_change=make_on_change_ux(ts))
                    )
            else:
                unix_timestamps_container.controls.append(ft.Text("Unix-метки не найдены", italic=True))
                
            btn_save_text.disabled = False if found_text else True
            btn_save_unix.disabled = False if found_unix else True
            
        except Exception as ex:
            status_label.value = f"Ошибка чтения файла: {str(ex)}"
            
        page.update()

    file_picker = ft.FilePicker(on_result=on_file_picked)
    page.overlay.append(file_picker)

    # --- КНОПКИ ДЕЙСТВИЯ ---
    def save_changes(new_content):
        nonlocal file_content
        try:
            with open(picked_file_path, "w", encoding="utf-8") as f:
                f.write(new_content)
            file_content = new_content
            # Перечитываем, чтобы обновить списки на экране
            status_label.value = f"Изменения успешно сохранены в {file_name}!"
            # Эмуляция перезапуска для обновления данных
            with open(picked_file_path, "r", encoding="utf-8") as f:
                file_content = f.read()
            reload_ui_lists()
        except Exception as ex:
            status_label.value = f"Ошибка сохранения: {str(ex)}"
        page.update()

    def reload_ui_lists():
        # Быстрое обновление списков на основе текущего контента файла
        text_dates_container.controls.clear()
        unix_timestamps_container.controls.clear()
        selected_text_dates.clear()
        selected_unix_timestamps.clear()
        
        found_text = sorted(list(set(re.findall(r'\d{2}\.\d{2}\.\d{4}', file_content))))
        for dt in found_text:
            text_dates_container.controls.append(ft.Checkbox(label=f"Дата: {dt}", on_change=lambda e, d=dt: selected_text_dates.add(d) if e.control.value else selected_text_dates.discard(d)))
            
        found_unix = sorted(list(set(re.findall(r'\b\d{10}\b', file_content))))
        for ts in found_unix:
            try: readable = datetime.datetime.fromtimestamp(int(ts)).strftime('%d.%m.%Y %H:%M')
            except: readable = "Неизвестно"
            unix_timestamps_container.controls.append(ft.Checkbox(label=f"{ts} ({readable})", on_change=lambda e, t=ts: selected_unix_timestamps.add(t) if e.control.value else selected_unix_timestamps.discard(t)))

    def apply_text_change(e):
        nonlocal file_content
        new_dt = new_date_input.value.strip()
        if not re.match(r'^\d{2}\.\d{2}\.\d{4}$', new_dt):
            status_label.value = "Ошибка: неверный формат новой даты (нужен ДД.ММ.ГГГГ)"
            page.update()
            return
        if not selected_text_dates:
            status_label.value = "Внимание: выберите даты галочками!"
            page.update()
            return
            
        updated = file_content
        for dt in selected_text_dates:
            updated = updated.replace(dt, new_dt)
        save_changes(updated)

    def apply_unix_change(e):
        nonlocal file_content
        if not selected_unix_timestamps:
            status_label.value = "Внимание: выберите Unix-метки галочками!"
            page.update()
            return
            
        updated = file_content
        for ts in selected_unix_timestamps:
            new_ts = str(int(ts) + 86400)
            updated = re.sub(r'\b' + ts + r'\b', new_ts, updated)
        save_changes(updated)

    btn_save_text = ft.ElevatedButton("Заменить выбранные даты", on_click=apply_text_change, disabled=True, bgcolor=ft.colors.BLUE, color=ft.colors.WHITE)
    btn_save_unix = ft.ElevatedButton("Прибавить неделю к выбранным", on_click=apply_unix_change, disabled=True, bgcolor=ft.colors.BLUE, color=ft.colors.WHITE)

    # --- ВЕРСТКА ИНТЕРФЕЙСА ---
    page.add(
        ft.AppBar(title=ft.Text("EXML Даты"), bgcolor=ft.colors.SURFACE_VARIANT),
        ft.Container(
            content=ft.Column([
                ft.ElevatedButton("Выбрать файл .exml", icon=ft.icons.FOLDER_OPEN, on_click=lambda _: file_picker.pick_files(allowed_extensions=["exml"]), width=300, height=45),
                status_label,
                ft.Divider(),
                
                ft.Tabs(
                    selected_index=0,
                    animation_duration=300,
                    tabs=[
                        ft.Tab(
                            text="Текстовые даты",
                            content=ft.Container(
                                content=ft.Column([
                                    ft.Text("Найденные даты (ДД.ММ.ГГГГ):", weight="bold"),
                                    text_dates_container,
                                    new_date_input,
                                    btn_save_text
                                ], spacing=15), padding=10
                            )
                        ),
                        ft.Tab(
                            text="Unix-метки",
                            content=ft.Container(
                                content=ft.Column([
                                    ft.Text("Найденные Unix-метки:", weight="bold"),
                                    unix_timestamps_container,
                                    btn_save_unix
                                ], spacing=15), padding=10
                            )
                        )
                    ], expand=1
                )
            ], horizontal_alignment=ft.CrossAxisAlignment.CENTER),
            padding=10
        )
    )

ft.app(target=main)
